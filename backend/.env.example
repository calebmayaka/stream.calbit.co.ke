# Copy to .env and fill in. .env is never committed.

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=stream.calbit.co.ke,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://stream.calbit.co.ke,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MEDIAHUB_SECURE_COOKIES=true
MEDIAHUB_SESSION_DAYS=30
# Optional first-account bootstrap; disabled when empty or any account exists.
MEDIAHUB_SETUP_CODE=

# --- Waitress (serve.py) ---
MEDIAHUB_HOST=127.0.0.1
MEDIAHUB_PORT=8013

# --- PostgreSQL (leave POSTGRES_DB empty to use SQLite in dev) ---
POSTGRES_DB=mediahub
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Jellyfin ---
# mock = canned data, no Jellyfin calls. live = real library.
MEDIAHUB_DATA_MODE=mock
JELLYFIN_URL=http://10.30.0.12:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# --- Playback ---
# A dedicated NON-admin Jellyfin user; its rotating session token goes into
# stream URLs. Admin users are refused.
JELLYFIN_STREAM_USER=mediahub-stream
JELLYFIN_STREAM_PASSWORD=
JELLYFIN_STREAM_TOKEN_HOURS=6
JELLYFIN_TOKEN_CLEANUP_SECONDS=60
# Public Jellyfin hostname for viewers coming through Cloudflare (see ../HANDOFF.md).
JELLYFIN_PUBLIC_URL=
